{
  "expo": {
    "name": "Streakify",
    "slug": "study-challenge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/streakify.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4A90E2"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow Streakify to access your photos for profile pictures.",
        "NSCameraUsageDescription": "Allow Streakify to use the camera for profile pictures.",
        "NSMicrophoneUsageDescription": "Allow Streakify to use the microphone for videos."
      },
      "bundleIdentifier": "com.studychallenge.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/streakify.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.studychallenge.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to set profile pictures.",
          "cameraPermission": "The app needs access to your camera to take profile pictures."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b55572da-cdfa-4602-8cd8-1b04cc15be83"
      }
    }
  }
}
